{
  "id": "hand-sword",
  "name": "Hand Sword Rhythm",
  "version": "1.0.0",
  "description": "Slice boxes to the beat with your hands. A rhythm game powered by hand tracking.",
  "author": "Motion Platform",
  "thumbnail": "/games/hand-sword/thumb.jpg",
  "remoteEntry": "http://localhost:5001/assets/remoteEntry.js",
  "production": "https://cdn.yourdomain.com/games/hand-sword/remoteEntry.js",
  "handTracking": {
    "mode": "dual",
    "minHands": 1,
    "maxHands": 2,
    "modelComplexity": 0
  },
  "multiplayer": {
    "supported": true,
    "maxPlayers": 2,
    "modes": ["competitive", "cooperative"]
  },
  "tags": ["rhythm", "music", "action", "hand-tracking"],
  "players": "1-2",
  "requirements": {
    "camera": true,
    "webgl": true,
    "webaudio": true
  },
  "performance": {
    "targetFPS": 60,
    "minFPS": 30,
    "bundleSize": "~200KB"
  }
}
