# Motion Platform Environment Variables
# Copy this to .env.local for local development

# =============================================================================
# FRONTEND (Netlify)
# =============================================================================

# Multiplayer server URL (Railway backend)
# Development: ws://localhost:2567
# Production: wss://your-app.railway.app
VITE_MULTIPLAYER_SERVER_URL=ws://localhost:2567

# =============================================================================
# BACKEND (Railway)
# =============================================================================

# Server port (Railway auto-assigns PORT)
PORT=2567

# Simulated latency for testing (milliseconds, 0 = disabled)
SIMULATE_LATENCY_MS=0

# =============================================================================
# OPTIONAL: CORS Configuration
# =============================================================================

# Allowed origins for CORS (comma-separated)
# CORS_ORIGINS=https://your-app.netlify.app,https://custom-domain.com
